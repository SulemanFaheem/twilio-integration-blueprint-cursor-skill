PORT=3000

TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: comma-separated ISO country codes (empty = allow all)
# ALLOWED_COUNTRY_CODES=US,CA,GB

# Public HTTPS origin for Twilio webhook signature validation
# PUBLIC_API_URL=https://api.example.com

# RATE_LIMIT_START_PER_PHONE=5
# RATE_LIMIT_CHECK_PER_PHONE=10
# RATE_LIMIT_WINDOW_MS=900000
